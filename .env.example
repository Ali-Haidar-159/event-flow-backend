# ========================================================
# EventFlow Backend - Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# ========================================================

# Server Port
PORT=3000

# PostgreSQL Database Connection String (Prisma)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/event_flow?schema=public"

# Nodemailer SMTP Configuration (Gmail or any SMTP provider)
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"

# Cloudinary Storage Configuration (for event banners and club logos)
CLOUD_NAME="your-cloudinary-cloud-name"
CLOUD_API_KEY="your-cloudinary-api-key"
CLOUD_API_SECRET="your-cloudinary-api-secret"
